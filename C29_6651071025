<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Return first and last name from a form</title>
</head>

<body>

<form id="form1" onsubmit="getFormvalue(); return false;">

    First name:
    <input type="text" name="fname" value="David">
    <br>

    Last name:
    <input type="text" name="lname" value="Beckham">
    <br>

    <input type="submit" value="Submit">

</form>

<script>
function getFormvalue() {
    var firstName = document.forms["form1"]["fname"].value;
    var lastName = document.forms["form1"]["lname"].value;

    alert("Họ và tên: " + firstName + " " + lastName);
}
</script>

</body>
</html>
