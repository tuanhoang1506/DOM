<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Return first and last name from a form</title>

    <!-- Link thư viện jQuery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.0/jquery.min.js"></script>
</head>

<body>

<form id="form1">
    First name:
    <input type="text" name="fname" value="David">
    <br>

    Last name:
    <input type="text" name="lname" value="Beckham">
    <br>

    <input type="submit" value="Submit">
</form>

<script>
$(document).ready(function () {

    $("#form1").submit(function (event) {

        event.preventDefault();

        // Lấy giá trị bằng jQuery
        var firstName = $("input[name='fname']").val();
        var lastName = $("input[name='lname']").val();

        alert("Họ và tên: " + firstName + " " + lastName);

    });

});
</script>

</body>
</html>
