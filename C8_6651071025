<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8">

    <title>Simple Calculator</title>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.0/jquery.min.js"></script>

    <style>
        body {
            margin: 30px;
        }

        input {
            width: 70px;
            height: 30px;
            font-size: 18px;
            text-align: center;
        }

        button {
            width: 40px;
            height: 35px;
            margin: 2px;
            font-size: 18px;
        }

        #result {
            width: 100px;
        }
    </style>

</head>

<body>

<input type="text" id="number1" value="12">

<button class="operator" data-op="+">+</button>
<button class="operator" data-op="-">-</button>
<button class="operator" data-op="*">×</button>
<button class="operator" data-op="/">/</button>
<button class="operator" data-op="^">^</button>

<input type="text" id="number2" value="14">

<span> = </span>

<input type="text" id="result" readonly>

<script>
$(document).ready(function () {

    $(".operator").click(function () {

        var number1 = parseFloat($("#number1").val());
        var number2 = parseFloat($("#number2").val());

        var operator = $(this).attr("data-op");

        var result;

        if (isNaN(number1) || isNaN(number2)) {

            alert("Vui lòng nhập hai số!");

            return;
        }

        switch (operator) {

            case "+":
                result = number1 + number2;
                break;

            case "-":
                result = number1 - number2;
                break;

            case "*":
                result = number1 * number2;
                break;

            case "/":

                if (number2 == 0) {
                    alert("Không thể chia cho 0!");
                    return;
                }

                result = number1 / number2;
                break;

            case "^":
                result = Math.pow(number1, number2);
                break;
        }

        // Hiển thị kết quả
        $("#result").val(result);

    });

});
</script>

</body>
</html>
